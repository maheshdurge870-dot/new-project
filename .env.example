# ============================================================
# Backend — copy values to backend/.env
# ============================================================

# Supabase Project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase Anon Key (Dashboard -> Project Settings -> API -> anon public)
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (Dashboard -> Project Settings -> API -> service_role SECRET)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Postgres connection (Dashboard -> Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT Secret (Dashboard -> Project Settings -> API -> JWT Secret)
SECRET_KEY=your_supabase_jwt_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# Frontend — copy values to frontend/.env
# ============================================================
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
